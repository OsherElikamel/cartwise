DATABASE_URL=postgresql+psycopg://cartwise_user:cartwise_password@localhost:5433/cartwise_db
JWT_SECRET_KEY=change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
BACKEND_CORS_ORIGINS=["http://localhost:5173"]
RATE_LIMIT_ENABLED=true
# Directory where downloaded price files are cached
DATA_DIR=data

# AI for list parsing + product matching (Gemini's free tier)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite

# Production: also allow origins matching this regex (e.g. the hosting subdomain)
CORS_ORIGIN_REGEX=
